{
  "name": "directus-extension-elevenlabs-tts",
  "version": "1.0.0",
  "description": "Operation to generate speech from text using ElevenLabs API with word timing",
  "icon": "extension",
  "keywords": ["directus", "directus-extension", "directus-custom-operation", "elevenlabs", "tts"],
  "type": "module",
  "directus:extension": {
    "type": "operation",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "source": {
      "app": "src/app.ts",
      "api": "src/api.ts"
    },
    "host": "^10.10.0 || ^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^12.0.0",
    "typescript": "^5.3.0"
  }
}
