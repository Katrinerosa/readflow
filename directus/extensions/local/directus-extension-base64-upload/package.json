{
  "name": "directus-extension-base64-upload",
  "version": "1.0.0",
  "description": "Operation to upload base64 encoded files to Directus assets",
  "icon": "extension",
  "keywords": ["directus", "directus-extension", "directus-custom-operation"],
  "type": "module",
  "directus:extension": {
    "type": "operation",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "source": {
      "app": "src/app.ts",
      "api": "src/api.ts"
    },
    "host": "^10.10.0 || ^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^12.0.0",
    "typescript": "^5.3.0"
  }
}
