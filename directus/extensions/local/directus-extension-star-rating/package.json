{
  "name": "directus-extension-star-rating",
  "version": "1.0.0",
  "description": "Star rating interface and display for Directus",
  "icon": "star",
  "keywords": ["directus", "directus-extension", "directus-custom-bundle", "rating", "stars"],
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "interface",
        "name": "star-rating-interface",
        "source": "src/interface/index.ts"
      },
      {
        "type": "display",
        "name": "star-rating-display",
        "source": "src/display/index.ts"
      }
    ],
    "host": "^10.10.0 || ^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^12.0.0",
    "typescript": "^5.3.0",
    "vue": "^3.4.0"
  }
}
