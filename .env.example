# =============================================================================
# ReadFlow - Environment Variables (single source for docker compose)
# Copy this file to `.env` and replace every CHANGE_ME value.
#
# Generate strong random values with one of:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Full Directus environment variable reference:
#   https://directus.io/docs/configuration/general
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=readflow
POSTGRES_USER=readflow
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Host port for Postgres (set to e.g. 55432 if you already run Postgres locally)
POSTGRES_HOST_PORT=5432
# Host port for Redis
REDIS_HOST_PORT=6379

# --- Directus -> Postgres connection (used by docker-compose) -----------------
POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432

# --- Directus core ------------------------------------------------------------
# Both KEY and SECRET MUST be at least 32 random characters.
# Pick fresh values — do not reuse production secrets. Existing user accounts
# in the restored data still work (passwords are hashed independently of KEY).
KEY=CHANGE_ME_directus_key_min_32_random_chars_xxxxxxxx
SECRET=CHANGE_ME_directus_secret_min_32_random_chars_xxxxxxx
PORT=8055
PUBLIC_URL=http://localhost:8055

# --- Directus admin bootstrap (created on first start) ------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Cache (Redis) ------------------------------------------------------------
REDIS_ENABLED=true
REDIS=redis://redis:6379

# --- CORS ---------------------------------------------------------------------
CORS_ENABLED=true
CORS_ORIGIN=*

# --- File storage -------------------------------------------------------------
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=/directus/uploads

# --- S3 file storage (optional) ----------------------------------------------
# Leave blank to use local storage above. To use S3-compatible storage
# (Hetzner, AWS S3, etc.), set STORAGE_LOCATIONS=s3 and fill these in.
# STORAGE_S3_BUCKET=
# STORAGE_S3_KEY=
# STORAGE_S3_SECRET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=

# --- Rate limiting ------------------------------------------------------------
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1

# --- External APIs ------------------------------------------------------------
# Optional. The ElevenLabs TTS extension generates audio for words and book
# content. Without a key the extension stays installed but inactive — the rest
# of the platform works fine.
# Create your own key at https://elevenlabs.io (sign up, then API → API keys).
# Leave the value empty if you don't intend to use text-to-speech yet.
API_KEY_ELEVEN_LABS=

# Whitelist of host env vars that Directus flow operations are allowed to read.
# Keep API_KEY_ELEVEN_LABS in this list so the elevenlabs-tts extension can
# read the key at runtime.
FLOWS_ENV_ALLOW_LIST=API_KEY_ELEVEN_LABS

# --- Data retention -----------------------------------------------------------
# Directus's built-in retention. Daily at 03:00 UTC trims old activity,
# revisions, and flow logs. Safe defaults — adjust as needed.
RETENTION_ENABLED=true
RETENTION_SCHEDULE=0 3 * * *
RETENTION_BATCH=1000
ACTIVITY_RETENTION=90d
REVISIONS_RETENTION=90d
FLOW_LOGS_RETENTION=30d

# --- Web app (Astro) ----------------------------------------------------------
# Browser-facing Directus URL (used by Vue reader at runtime).
PUBLIC_DIRECTUS_URL=http://localhost:8055
# Server-to-server Directus URL (Astro SSR -> Directus inside docker network).
DIRECTUS_URL=http://directus:8055
