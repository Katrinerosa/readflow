---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import { t, getLanguageFromPath, type Language } from "../../../lib/i18n";
import { safeHtml } from "../../../lib/html-utils";
import Supporters from "../../../components/Supporters.astro";

const lang = getLanguageFromPath(Astro.url.pathname) as Language;

const translations = {
  title: await t("about.title", lang),
  subtitle: await t("about.subtitle", lang),
  missionTitle: await t("about.mission.title", lang),
  missionText: await t("about.mission.text", lang, { preserveHtml: true }),
  featuresTitle: await t("about.features.title", lang),
  featuresText: await t("about.features.text", lang, { preserveHtml: true }),
};
---

<Layout title={`${translations.title} - ReadFlow`} description={translations.subtitle}>
  <article class="about-page">
    <div class="page-header">
      <h1>{translations.title}</h1>
      <p class="subtitle">{translations.subtitle}</p>
    </div>

    <section class="mission-section">
      <h2>{translations.missionTitle}</h2>
      <div class="mission-text rich-text" set:html={safeHtml(translations.missionText)} />
    </section>

    <section class="features-section">
      <h2>{translations.featuresTitle}</h2>
      <div class="features-content rich-text" set:html={safeHtml(translations.featuresText)} />
    </section>
  </article>

  <Supporters lang={lang} />
</Layout>

<style>
  .about-page {
  }

  .page-header {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-light);
    margin-bottom: 0;
  }

  section {
    margin-bottom: 3rem;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .mission-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-light);
  }

  .features-list {
    list-style: disc;
    padding-left: 2rem;
    display: grid;
    gap: 1rem;
  }

  .features-list li {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
  }

  .rich-text :global(p) {
    font-size: 1.15rem;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .rich-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .mission-section .rich-text :global(p) {
    color: var(--text-light);
  }

  .features-content :global(ul),
  .features-content :global(ol) {
    list-style: disc;
    padding-left: 2rem;
  }

  .features-content :global(ol) {
    list-style: decimal;
  }

  .features-content :global(li) {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .features-content :global(li p) {
    margin: 0;
  }

  .rich-text :global(a) {
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 1rem;
    }

    .about-header h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1.1rem;
    }

    h2 {
      font-size: 1.5rem;
    }
  }
</style>
