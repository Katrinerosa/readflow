  .btn-primary:hover {
    background: var(--primary-hover);
    box-shadow: 0 4px 8px rgba(15, 42, 145, 0.3);
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.5rem;
    background: white;
    color: var(--primary);
    text-decoration: none;
    border: 2px solid var(--primary);
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 600;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }

  .btn-secondary:hover {
    background: var(--primary);
    color: white;
    transform: translateY(-1px);
  }

  .see-more-books-action {
    margin: 3rem 0 1rem;
  }

  /* Reading Experience Section */
  .reading-experience-section {
    position: relative;
    margin: 3rem 0;
    padding: 2rem;
    background: var(--bg-alt);
    border-radius: 12px;
    border-left: 4px solid var(--primary);
  }

  .hide-section-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: var(--text-light);
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.15s, color 0.15s;
  }

  .hide-section-btn:hover {
    background: rgba(15, 42, 145, 0.08);
    color: var(--primary);
  }

  .reading-experience-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .reading-experience-intro {
    font-size: 1rem;
    line-height: 1.6;
    color: #4b5563;
    margin-bottom: 1.5rem;
  }

  .pages-count {
    font-size: 1.25rem;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .pages-count strong {
    color: var(--primary);
    font-size: 1.5rem;
  }

  /* Level tabs */
  .level-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .level-tab {
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--border);
    background: white;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--text-light);
