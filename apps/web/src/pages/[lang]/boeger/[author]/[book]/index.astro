---
import Layout from "../../../../../layouts/Layout.astro";
import { getBookByAuthorAndSlug, directus, isBookAvailableInLanguage } from "../../../../../lib/directus";
import { readItems } from "@directus/sdk";
import { t, getLanguageFromPath, type Language } from "../../../../../lib/i18n";
import { localizedRoute } from "../../../../../lib/routes";

// Type for book content statistics
interface BookContentStats {
  reading_level: string;
  word_count: number;
  chapter_count: number;
  image_count: number;
  lix: number;
  status: string;
}

const { author, book } = Astro.params;
const lang = getLanguageFromPath(Astro.url.pathname) as Language;

if (!author || !book) {
  return Astro.redirect(localizedRoute(lang, "books"));
}

let bookData;
let authorData;
let bookContentStats: BookContentStats[] = [];

try {
  bookData = await getBookByAuthorAndSlug(author, book);

  if (!bookData) {
    return Astro.redirect(localizedRoute(lang, "books"));
  }

  // Check if book has complete translations for this language
  const hasCompleteTranslations = await isBookAvailableInLanguage(bookData.id, lang);
  if (!hasCompleteTranslations) {
    console.warn(`Book ${bookData.slug} does not have complete translations for ${lang}`);
    return Astro.redirect(localizedRoute(lang, "books"));
  }

  authorData = (typeof bookData.author_id === 'object' ? bookData.author_id : null) || (typeof bookData.author === 'object' ? bookData.author : null);

  // Fetch book translations
  try {
    const bookTranslations = await directus.request(
      readItems("books_translations", {
        filter: {
          _and: [
            { books_id: { _eq: bookData.id } },
            { languages_code: { _eq: lang } }
          ]
        },
        limit: 1,
      })
    );

    if (bookTranslations && bookTranslations[0]) {
      const trans = bookTranslations[0];
      bookData = {
        ...bookData,
        description: trans.description,
        excerpt: trans.excerpt,
        instruction: trans.instruction,
        final_words: trans.final_words,
      };
    }
  } catch (e) {
    console.warn("Could not load book translations:", e);
  }

  // Fetch author bio translation
  if (authorData) {
    try {
      const authorTranslations = await directus.request(
        readItems("authors_translations", {
          filter: {
            _and: [
              { authors_id: { _eq: authorData.id } },
              { languages_code: { _eq: lang } }
            ]
          },
          limit: 1,
        })
      );

      if (authorTranslations && authorTranslations[0] && authorTranslations[0].bio) {
        authorData = {
          ...authorData,
          bio: authorTranslations[0].bio
        };
      }
    } catch (e) {
      console.warn("Could not load author translations:", e);
    }
  }

  // Fetch book content statistics for all reading levels
  try {
    // First get all book_content entries for this book with their reading levels
    const bookContents = await directus.request(
      readItems("book_content", {
        filter: {
          book: { _eq: bookData.id }
        },
        fields: ["id", "reading_level"],
      })
    );

    if (bookContents && bookContents.length > 0) {
      // Create a map of book_content_id -> reading_level
      const readingLevelMap: Record<string, string> = {};
      bookContents.forEach((bc: any) => {
        readingLevelMap[bc.id] = bc.reading_level;
      });

      // Get translations with stats for each book_content and current language
      const bookContentIds = bookContents.map((bc: any) => bc.id);

      const contentTranslations = await directus.request(
        readItems("book_content_translations", {
          filter: {
            _and: [
              { book_content_id: { _in: bookContentIds } },
              { languages_code: { _eq: lang } },
              { status: { _eq: "published" } }
            ]
          },
          fields: ["book_content_id", "word_count", "chapter_count", "image_count", "lix", "status"],
        })
      );

      if (contentTranslations) {
        // Map translations to stats with correct reading_level from parent book_content
        bookContentStats = contentTranslations.map((trans: any) => ({
          reading_level: readingLevelMap[trans.book_content_id] || 'easy',
          word_count: trans.word_count || 0,
          chapter_count: trans.chapter_count || 0,
          image_count: trans.image_count || 0,
          lix: trans.lix || 0,
          status: trans.status,
        }));

        // Sort by reading level: basic, easy, medium, difficult, hard
        const levelOrder = { basic: 1, easy: 2, medium: 3, difficult: 4, hard: 5 };
        bookContentStats.sort((a, b) =>
          (levelOrder[a.reading_level as keyof typeof levelOrder] || 99) -
          (levelOrder[b.reading_level as keyof typeof levelOrder] || 99)
        );
      }
    }
  } catch (e) {
    console.warn("Could not load book content statistics:", e);
  }
} catch (error) {
  console.error("Error loading book page:", error);
  return Astro.redirect(`/${lang}/books`);
}

// Load translations
const translations = {
  by: await t("common.by", lang),
  startReading: await t("book.start_reading", lang),
  aboutBook: await t("book.about_book", lang),
  bookInfo: await t("book.information", lang),
  page: await t("book.page", lang),
  pages: await t("book.pages", lang),
  aboutAuthor: await t("book.about_author", lang),
  // Reading level translations
  levelBasic: await t("book.level.basic", lang),
  levelEasy: await t("book.level.easy", lang),
  levelMedium: await t("book.level.medium", lang),
  levelDifficult: await t("book.level.difficult", lang),
  levelHard: await t("book.level.hard", lang),
  // Stats translations
  statsWords: await t("book.stats.words", lang),
  statsChapters: await t("book.stats.chapters", lang),
  statsIllustrations: await t("book.stats.illustrations", lang),
  statsLix: await t("book.stats.lix", lang),
  availableLevels: await t("book.available_levels", lang),
  // New translations for redesigned page
  excerpt: await t("book.excerpt", lang),
  readingExperience: await t("book.reading_experience", lang),
  readingExperienceIntro: await t("book.reading_experience_intro", lang),
  // Level-specific reading buttons
  readNow: await t("book.read_now", lang),
  readInLevel: await t("book.read_in_level", lang),
  seeMoreBooks: await t("book.see_more_books", lang),
  hideReadingExperience: await t("book.hide_reading_experience", lang),
};

const booksUrl = localizedRoute(lang, "books");

// Helper to get level label
const getLevelLabel = (level: string) => {
  switch (level) {
    case 'basic': return translations.levelBasic;
    case 'easy': return translations.levelEasy;
    case 'medium': return translations.levelMedium;
    case 'difficult': return translations.levelDifficult;
    case 'hard': return translations.levelHard;
    default: return level;
  }
};

// Helper to get level-specific reading button text
const getReadInLevelText = (level: string) => {
  const levelLabel = getLevelLabel(level).toLowerCase();
  return translations.readInLevel.replace('{level}', levelLabel);
};
---

<Layout title={`${bookData.title} - ReadFlow`} description={bookData.description}>
  <article class="book-detail">
    <!-- Top Section: Cover, Title, Author, Excerpt -->
    <div class="book-header">
      {
        bookData.cover_image && (
          <img
            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${bookData.cover_image}`}
            alt={bookData.title}
          />
        )
      }
      <div class="book-meta">
        <h1>{bookData.title}</h1>
        {authorData && (
          <p class="author">
            {translations.by} <a href={`/${lang}/books/${authorData.slug}`}>{authorData.name}</a>
          </p>
        )}

        {bookData.excerpt && (
          <div class="excerpt-content" set:html={bookData.excerpt}></div>
        )}

        {/* Read Now Button - direct link to start reading. href is rewritten
            client-side to honour the user's saved reading level (see script). */}
        {bookContentStats.length > 0 && (
          <div class="read-now-action">
            <a
              href={`/reader/${lang}/${author}/${book}/level/${bookContentStats[0]?.reading_level || 'easy'}/page/1`}
              class="btn btn-primary btn-large"
              id="read-now-btn"
              data-base-url={`/reader/${lang}/${author}/${book}`}
              data-available-levels={JSON.stringify(bookContentStats.map(s => s.reading_level))}
            >
              {translations.readNow}
            </a>
          </div>
        )}
      </div>
    </div>

    <!-- Reading Experience Section -->
    {
      bookContentStats.length > 0 ? (
        <section class="reading-experience-section" id="reading-experience-section" hidden>
          <button
            type="button"
            class="hide-section-btn"
            id="hide-reading-experience-btn"
            aria-label={translations.hideReadingExperience}
            title={translations.hideReadingExperience}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
          <h2>{translations.readingExperience}</h2>

          <p class="reading-experience-intro">{translations.readingExperienceIntro}</p>

          {/* Reading Level Tabs */}
          <div class="level-tabs" role="tablist">
            {bookContentStats.map((stats, index) => (
              <button
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                class={`level-tab ${index === 0 ? 'active' : ''}`}
                data-level={stats.reading_level}
                data-index={index}
              >
                {getLevelLabel(stats.reading_level)}
              </button>
            ))}
          </div>

          {/* Statistics Display - Single grid that updates */}
          <div class="stats-container" data-stats={JSON.stringify(bookContentStats.map(s => ({
            word_count: s.word_count,
            chapter_count: s.chapter_count,
            image_count: s.image_count,
            lix: s.lix,
            reading_level: s.reading_level
          })))} data-level-texts={JSON.stringify(bookContentStats.map(s => getReadInLevelText(s.reading_level)))}>
            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-value" data-stat="word_count" data-target={bookContentStats[0]?.word_count || 0}>0</span>
                <span class="stat-label">{translations.statsWords}</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" data-stat="chapter_count" data-target={bookContentStats[0]?.chapter_count || 0}>0</span>
                <span class="stat-label">{translations.statsChapters}</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" data-stat="image_count" data-target={bookContentStats[0]?.image_count || 0}>0</span>
                <span class="stat-label">{translations.statsIllustrations}</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" data-stat="lix" data-target={bookContentStats[0]?.lix || 0}>0</span>
                <span class="stat-label">{translations.statsLix}</span>
              </div>
            </div>
          </div>

          {bookData.instruction && (
            <div class="info-text" set:html={bookData.instruction}></div>
          )}

          {/* Start Reading Button - with level-specific text */}
          <div class="actions">
            <a
              href={`/reader/${lang}/${author}/${book}/level/${bookContentStats[0]?.reading_level || 'easy'}/page/1`}
              class="btn btn-primary"
              id="start-reading-btn"
              data-base-url={`/reader/${lang}/${author}/${book}`}
            >
              {getReadInLevelText(bookContentStats[0]?.reading_level || 'easy')}
            </a>
          </div>
        </section>
      ) : null
    }

    <!-- About the Book Section -->
    {(bookData.description || authorData) && (
      <section class="about-book-section">
        <h2>{translations.aboutBook}</h2>
        <div class="about-book-content">
          {bookData.description && (
            <div class="book-description">
              <div class="description-content" set:html={bookData.description}></div>
            </div>
          )}
          {authorData && (
            <div class="author-info">
              {authorData.photo && (
                <img
                  src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${authorData.photo}`}
                  alt={authorData.name}
                  class="author-photo"
                />
              )}
              <div>
                <h3><a href={`/${lang}/books/${authorData.slug}`}>{authorData.name}</a></h3>
                {authorData.bio && (
                  <div class="bio-content" set:html={authorData.bio}></div>
                )}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <div class="see-more-books-action">
      <a href={booksUrl} class="btn btn-secondary">{translations.seeMoreBooks}</a>
    </div>
  </article>
</Layout>

<style>
  .book-detail {
  }

  .book-header {
    display: flex;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .book-header img {
    width: 300px;
    height: 420px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 4px 12px var(--shadow);
  }

  .book-meta {
    flex: 1;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .author {
    font-size: 1.25rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  .author a {
    color: var(--primary);
    text-decoration: none;
  }

  .author a:hover {
    text-decoration: underline;
  }

  .excerpt-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #4b5563;
    font-style: italic;
  }

  .excerpt-content :global(p) {
    margin-bottom: 1rem;
  }

  .excerpt-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .read-now-action {
    margin-top: 1.5rem;
  }

  .btn-large {
    font-size: 1.25rem;
    padding: 1rem 2rem;
  }

  .description-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #4b5563;
  }

  .description-content :global(p) {
    margin-bottom: 1rem;
  }

  .description-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px; /* Dyslexia-friendly minimum touch target */
    padding: 0.75rem 1.5rem;
    background: var(--primary);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 600;
    transition: background 0.15s, box-shadow 0.15s, transform 0.15s;
    box-shadow: 0 2px 4px rgba(15, 42, 145, 0.2);
