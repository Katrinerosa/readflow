  .level-tab:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .level-tab.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Stats container */
  .stats-container {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .stats-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
    margin: 1.5rem 0;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
    line-height: 1.2;
    min-width: 5ch; /* Space for up to 99999 */
    text-align: center;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .info-text {
    color: #6b7280;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  /* About the Book Section */
  .about-book-section {
    margin-top: 3rem;
  }

  .about-book-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .about-book-content {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2rem;
    align-items: start;
  }

  .book-description {
    flex: 1;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .author-photo {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #e5e7eb;
    margin-bottom: 1rem;
  }

  .author-info h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .author-info h3 a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s;
  }

  .author-info h3 a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .bio-content {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #4b5563;
  }

  .bio-content :global(p) {
    margin-bottom: 0.75rem;
  }

  .bio-content :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .book-detail {
      padding: 1rem;
    }

    .book-header {
      flex-direction: column;
      gap: 2rem;
    }

    .book-header img {
      width: 100%;
      max-width: 300px;
      margin: 0 auto;
    }

    h1 {
      font-size: 2rem;
    }

    .reading-experience-section {
      padding: 1.5rem;
    }

    .about-book-content {
      grid-template-columns: 1fr;
    }

    .author-info {
      order: -1;
    }

    .stats-grid {
      justify-content: center;
    }
  }
</style>

<script>
  // Animated number counter with easing
  function animateNumber(element: HTMLElement, target: number, duration: number = 600) {
    const start = parseInt(element.textContent || '0');
    const startTime = performance.now();

    function easeOutExpo(t: number): number {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
    }

    function update(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = easeOutExpo(progress);
      const current = Math.round(start + (target - start) * easedProgress);

      element.textContent = current.toString();

      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }

    requestAnimationFrame(update);
  }

  // Update stats to show values for a specific level index
  function updateStats(statsContainer: HTMLElement, levelIndex: number) {
    const statsData = JSON.parse(statsContainer.getAttribute('data-stats') || '[]');
    const levelStats = statsData[levelIndex];

    if (!levelStats) return;

    // Animate each stat value to its new target
    const statElements = statsContainer.querySelectorAll('.stat-value');
    statElements.forEach((el) => {
      const statKey = el.getAttribute('data-stat');
      if (statKey && levelStats[statKey] !== undefined) {
        const newTarget = levelStats[statKey];
        el.setAttribute('data-target', newTarget.toString());
        animateNumber(el as HTMLElement, newTarget);
      }
    });

    // Update the start reading button URL and text with the selected level
    const startReadingBtn = document.getElementById('start-reading-btn') as HTMLAnchorElement;
    if (startReadingBtn && levelStats.reading_level) {
      const baseUrl = startReadingBtn.getAttribute('data-base-url') || '';
      startReadingBtn.href = `${baseUrl}/level/${levelStats.reading_level}/page/1`;

      // Update button text with level-specific text
      const levelTexts = JSON.parse(statsContainer.getAttribute('data-level-texts') || '[]');
      if (levelTexts[levelIndex]) {
        startReadingBtn.textContent = levelTexts[levelIndex];
      }
    }
  }

  // Read saved reading level from reader's localStorage
  function getSavedLevel(): string | null {
    try {
      const raw = localStorage.getItem('reader-settings');
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      return parsed?.lixLevel || null;
    } catch (e) {
      return null;
    }
  }

  // Update the top "Read Now" button href to point at the given level
  function updateReadNowButton(level: string) {
    const btn = document.getElementById('read-now-btn') as HTMLAnchorElement | null;
    if (!btn) return;
    const baseUrl = btn.getAttribute('data-base-url') || '';
    btn.href = `${baseUrl}/level/${level}/page/1`;
  }

  // Pick a level for the read-now button: saved level if available for this book,
  // otherwise fall back to the first available (typically easiest).
  function pickInitialLevel(availableLevels: string[]): string {
    const saved = getSavedLevel();
    if (saved && availableLevels.includes(saved)) return saved;
    return availableLevels[0] || 'easy';
  }

  const READING_EXPERIENCE_HIDDEN_KEY = 'readflow-reading-experience-hidden';

  function isReadingExperienceHidden(): boolean {
    try {
      return localStorage.getItem(READING_EXPERIENCE_HIDDEN_KEY) === '1';
    } catch {
      return false;
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.level-tab');
    const statsContainer = document.querySelector('.stats-container');
    const readNowBtn = document.getElementById('read-now-btn');
    const readingExperienceSection = document.getElementById('reading-experience-section');
    const hideBtn = document.getElementById('hide-reading-experience-btn');

    // The section is rendered with `hidden` so SSR'd output doesn't flash for users
    // who have already dismissed it. Reveal it now if the dismissal flag isn't set.
    if (readingExperienceSection && !isReadingExperienceHidden()) {
      readingExperienceSection.removeAttribute('hidden');
    }

    if (hideBtn && readingExperienceSection) {
      hideBtn.addEventListener('click', () => {
        readingExperienceSection.setAttribute('hidden', '');
        try { localStorage.setItem(READING_EXPERIENCE_HIDDEN_KEY, '1'); } catch {}
      });
    }

    // Sync the top "Read Now" button with the saved level even when there are
    // no level tabs (e.g. legacy books without bookContentStats).
    if (readNowBtn) {
      const available = JSON.parse(readNowBtn.getAttribute('data-available-levels') || '[]');
      updateReadNowButton(pickInitialLevel(available));
    }

    if (!statsContainer) return;

    // Preselect tab matching saved level (fallback to first if not available)
    const savedLevel = getSavedLevel();
    let initialIndex = 0;
    if (savedLevel) {
      const matchIdx = Array.from(tabs).findIndex(
        (t) => t.getAttribute('data-level') === savedLevel,
      );
      if (matchIdx >= 0) initialIndex = matchIdx;
    }
    if (initialIndex !== 0) {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      const initialTab = tabs[initialIndex];
      if (initialTab) {
        initialTab.classList.add('active');
        initialTab.setAttribute('aria-selected', 'true');
      }
      updateStats(statsContainer as HTMLElement, initialIndex);
    } else {
      // Animate initial values for first tab
      const statElements = statsContainer.querySelectorAll('.stat-value');
      statElements.forEach((el) => {
        const target = parseInt(el.getAttribute('data-target') || '0');
        animateNumber(el as HTMLElement, target);
      });
    }

    // Tab click handler
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const index = parseInt(tab.getAttribute('data-index') || '0');

        // Update tab states
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        // Update stats with animation
        updateStats(statsContainer as HTMLElement, index);

        // Keep the top Read Now button in sync with the active tab
        const level = tab.getAttribute('data-level');
        if (level) updateReadNowButton(level);
      });
    });
  });
</script>
